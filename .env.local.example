# .env.local için şablon: kopyalayıp .env.local yap. Gerçek anahtarları commit etme.
# Stripe TEST modu: Dashboard sağ üstte "Test mode" açıkken oluşturulan price_... ID'leri.
# Canlıya geçerken bu satırları LIVE mod ID'leriyle değiştir (Vercel env'e de aynısını gir).
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Temel (yalnızca QR menü): Aylık 499 TL, Yıllık 4.990 TL
STRIPE_PRICE_ID_MONTHLY_BASIC=price_test_
STRIPE_PRICE_ID_YEARLY_BASIC=price_test_
# Başlangıç: Aylık 999 TL, Yıllık 9.990 TL
STRIPE_PRICE_ID_MONTHLY=price_test_
STRIPE_PRICE_ID_YEARLY=price_test_
# Profesyonel: Aylık 1.499 TL, Yıllık 14.990 TL
STRIPE_PRICE_ID_MONTHLY_PRO=price_test_
STRIPE_PRICE_ID_YEARLY_PRO=price_test_
# Tek seferlik: kurulum 2.500 TL, görsel paketi 400 TL, toplu 50 foto 999 TL, toplu 100 foto 1.999 TL
STRIPE_PRICE_ID_SETUP=price_test_
STRIPE_PRICE_ID_IMAGE_PACK=price_test_
STRIPE_PRICE_ID_BULK50=price_test_
STRIPE_PRICE_ID_BULK100=price_test_
# Ömür boyu menü: 12.000 TL (50 ürün) + ek 50'lik blok 4.000 TL
STRIPE_PRICE_ID_LIFETIME=price_test_
STRIPE_PRICE_ID_LIFETIME_EXTRA_BLOCK=price_test_
