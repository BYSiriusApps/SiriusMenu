# Landing (/) ve ücretsiz deneme (/app), anahtarsız tam çalışır (menü + QR + tema tamamen tarayıcıda).
# "AI açıklama" butonu (ürün açıklaması) DAHİL tüm AI özellikleri GEMINI_API_KEY kullanır (aşağıda).
# Boş bırakırsan açıklama önerici hazır demo metni gösterir.

# Panel (/panel), giriş/kayıt ve yayınlanan menüler (/m/[slug]) için Supabase gerekir.
# Lokal geliştirme: `npm run supabase:start` sonrası terminaldeki API URL / anon key / service_role key buraya.
# Prod: supabase.com'da proje oluştur, Project Settings > API'den al.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Test modunda sk_test_/pk_test_ yeterli.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# `npm run stripe:listen` çalıştırınca terminalde çıkan whsec_... değeri.
STRIPE_WEBHOOK_SECRET=
# Abonelik price'ları (Stripe Dashboard > Products). Aylık 749 TL, Yıllık 7490 TL (recurring).
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Tek seferlik price'lar: kurulum 2500 TL, 20'li görsel paketi 400 TL, toplu 50/100 foto 999/1799 TL.
STRIPE_PRICE_ID_SETUP=
STRIPE_PRICE_ID_IMAGE_PACK=
STRIPE_PRICE_ID_BULK50=
STRIPE_PRICE_ID_BULK100=

# Gemini — yemek fotoğrafı iyileştirme/üretme, WhatsApp menü komut ayrıştırma ve "AI açıklama" butonu.
# https://aistudio.google.com/apikey . Boşsa görsel iyileştirme, WhatsApp AI ve AI açıklama kapalı olur
# (açıklama butonu bu durumda hazır demo metni gösterir).
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image

# Evolution API (kendi barındırılan WhatsApp gateway) — bkz. docs/evolution-api-kurulum.md
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=siriusmenu
# Evolution instance'ına bağlı WhatsApp numarası (işletmelerin yazacağı numara), E.164: +90...
WHATSAPP_BUSINESS_NUMBER=
# Evolution webhook'unu korumak için rastgele bir dize; Evolution webhook URL'sine ?secret=... ekle.
WHATSAPP_WEBHOOK_SECRET=

# Vercel Cron route'larını korumak için rastgele bir dize (Vercel otomatik Bearer gönderir).
CRON_SECRET=
